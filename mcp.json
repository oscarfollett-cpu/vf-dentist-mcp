{
  "schema_version": "1.0",
  "name": "Dentist Calendar MCP",
  "description": "REST-based MCP server for dentist appointment scheduling",
  "tools": [
    {
      "name": "check_availability",
      "description": "Check if a time slot is available",
      "method": "POST",
      "path": "/check"
    },
    {
      "name": "create_appointment",
      "description": "Create a dentist appointment",
      "method": "POST",
      "path": "/create"
    },
    {
      "name": "update_appointment",
      "description": "Reschedule an existing appointment",
      "method": "POST",
      "path": "/update"
    },
    {
      "name": "delete_appointment",
      "description": "Cancel an appointment",
      "method": "POST",
      "path": "/delete"
    }
  ]
}
