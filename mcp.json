{
  "mcp": {
    "version": "1.0",
    "name": "DentistMCP",
    "description": "MCP server providing calendar scheduling tools for a dental receptionist AI.",
    "server": {
      "type": "http"
    },
    "models": [],
    "tools": [
      {
        "name": "check_availability",
        "description": "Check if a time slot is free and get a booking token.",
        "input": {
          "type": "object",
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          },
          "required": ["start", "end"]
        },
        "output": {
          "type": "object"
        },
        "endpoint": {
          "type": "http",
          "method": "POST",
          "url": "https://vf-dentist-mcp-production.up.railway.app/check"
        }
      },
      {
        "name": "create_appointment",
        "description": "Create a dentist appointment after checking availability.",
        "input": {
          "type": "object",
          "properties": {
            "token": { "type": "string" },
            "title": { "type": "string" },
            "start": { "type": "string" },
            "end": { "type": "string" },
            "patient": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string" },
                "phone": { "type": "string" }
              },
              "required": ["name", "phone"]
            }
          },
          "required": ["token", "title", "start", "end", "patient"]
        },
        "output": { "type": "object" },
        "endpoint": {
          "type": "http",
          "method": "POST",
          "url": "https://vf-dentist-mcp-production.up.railway.app/create"
        }
      },
      {
        "name": "update_appointment",
        "description": "Reschedule a dentist appointment.",
        "input": {
          "type": "object",
          "properties": {
            "eventId": { "type": "string" },
            "start": { "type": "string" },
            "end": { "type": "string" }
          },
          "required": ["eventId", "start", "end"]
        },
        "output": { "type": "object" },
        "endpoint": {
          "type": "http",
          "method": "POST",
          "url": "https://vf-dentist-mcp-production.up.railway.app/update"
        }
      },
      {
        "name": "delete_appointment",
        "description": "Cancel an appointment using its eventId.",
        "input": {
          "type": "object",
          "properties": {
            "eventId": { "type": "string" }
          },
          "required": ["eventId"]
        },
        "output": { "type": "object" },
        "endpoint": {
          "type": "http",
          "method": "POST",
          "url": "https://vf-dentist-mcp-production.up.railway.app/delete"
        }
      }
    ]
  }
}